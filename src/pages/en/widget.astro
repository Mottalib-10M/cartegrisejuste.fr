---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/cout-carte-grise/?lang=en" title="French car registration cost 2026" width="100%" height="980" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French car registration cost calculator 2026" description="Embed the French car registration cost calculator for 2026 free of charge: one iframe code to copy, no account and no cookie, with the rates of all 18 regions kept up to date for you." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no account and no fee. Relocation advisers, expat forums, garages and newsrooms set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link shown under the calculator stays visible, the calculator is not altered, and it comes with no warranty. Regional rates and malus scales are updated on this site, so your page stays current without any work. French version: <code>{`${SITE_URL}/embed/cout-carte-grise/`}</code>.</p>
    <p>Your visitors’ inputs stay in their browser and the embedded frame sets no cookie on your site. For any request, use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/cout-carte-grise/?lang=en" title="French car registration cost 2026" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
